# Copy this file to ".env" and fill in your own values. Never commit ".env".

PORT=4001
NODE_ENV=development

# Database: either one connection string...
# DATABASE_URL=mysql://user:password@host:3306/databasename
# ...or the separate values below (these win over DATABASE_URL when both are set).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=surveyops
DB_PASSWORD=change_me
DB_NAME=surveyops
# Set to true when the database requires an encrypted connection (most hosted databases do).
DB_SSL=false

# Production only (see README, "Deployment"):
# SERVE_FRONTEND=true      Express also serves the built React app from ../frontend/dist
# TRUST_PROXY=1            number of hosting proxies in front of the app (needed for correct rate limiting)
# CORS_ORIGIN=https://...  only if the frontend is hosted at a different address

# Rate limiting, per IP address (defaults shown)
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_API_MAX=500
# RATE_LIMIT_WRITE_MAX=100
